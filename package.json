{
  "name": "ng5-slider",
  "version": "1.2.6",
  "private": true,
  "description": "Self-contained, mobile friendly slider component for Angular 19+ based on angularjs-slider",
  "keywords": [
    "slider",
    "ui",
    "component",
    "angular",
    "ng",
    "angular19",
    "ng19",
    "standalone"
  ],
  "author": "Piotr Dziwinski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/angular-slider/ng5-slider.git"
  },
  "bugs": {
    "url": "https://github.com/angular-slider/ng5-slider/issues"
  },
  "homepage": "https://github.com/angular-slider/ng5-slider#readme",
  "scripts": {
    "start": "ng serve --port 4202",
    "build": "npm run build:lib && npm run build:demo-app",
    "build:lib": "npm run prepare && rimraf dist/ dist/ng5-slider.tgz && ng-packagr -p src/ng5-slider/package.json && scss-bundle -e src/ng5-slider/lib/main.scss -d dist/ng5-slider/scss/ng5-slider.scss && rimraf dist/ng5-slider.tgz",
    "build:demo-app": "npm run prepare && rimraf dist/demo-app && ng build --prod --base-href /ng5-slider/",
    "publish-gh": "scripts/publish-gh-pages.sh",
    "lint": "npm run prepare && ng lint",
    "ci": "npm run lint && npm run build:lib && npm run build:demo-app"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@ng-bootstrap/ng-bootstrap": "^18.0.0",
    "core-js": "^3.39.0",
    "detect-passive-events": "^1.0.4",
    "rxjs": "^7.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~19.0.5",
    "@angular/cli": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/language-service": "^19.0.0",
    "@types/node": "^22.10.1",
    "codelyzer": "^6.0.2",
    "escape-html": "^1.0.3",
    "mkdirp": "^3.0.1",
    "ng-packagr": "^19.0.0",
    "prismjs": "^1.29.0",
    "rimraf": "^6.0.1",
    "scss-bundle": "^3.1.2",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typedoc": "^0.26.11",
    "typescript": "~5.6.3"
  }
}
